================================================================================
process constructs with replication, conditionals, table operations, and events
================================================================================
table entries(bitstring, nat).
event accepted(bitstring).
process !in(c, (=tag, x:bitstring));
  if x = value then
    insert entries(x, 1);
    event accepted(x);
    out(c, (x, 2))
  else 0

