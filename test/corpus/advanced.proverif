fun zero(): nat.
fun successor(nat): nat
  reduc forall x: nat; successor(x) = x + 1
  otherwise forall x: nat; successor(x) = fail.
event reached(nat).
query x: nat; inj-event(reached(x)) ==> attacker(x) public_vars x.
process foreach i <= n do !event reached(successor(zero())); sync 1[tag]; 0

