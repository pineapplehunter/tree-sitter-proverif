================================================================================
Empty macros, may-fail variables, reductions, choices and projections
================================================================================
fun f(bitstring): bitstring
  reduc forall x: bitstring or fail; f(x) = fail
  otherwise f() = diff[a, b].
letfun identity(x: bitstring or fail) = x.
let empty() = 0.
equation forall x: bitstring; y <- 1-proj-bitstring(x); f(y) = choice[a, b].
reduc forall x: bitstring; f(x) = x; f(a) = b.
process empty()

