================================================================================
Typed choice patterns, bounded replication, event arguments and process terms
================================================================================
letfun store(x: bitstring) = insert cache(x); event stored(x)[x]; x.
process
  !i <= N
  in(c, (diff[x, y]: bitstring, _: bitstring));
  event stored(x)[x];
  let z = store(x) in out(c, z)

