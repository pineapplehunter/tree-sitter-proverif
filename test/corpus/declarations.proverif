================================================================================
letproba declaration
================================================================================

letproba Penc_multikey(t:time,N,N2,N3,N4:number,lenc,ldec:length) =
  N3 * (N + N4) * Penc(t + (N4+N-1) * time(enc_r, lenc) +
  (N3-1)*(time(pkgen) + time(skgen) + N2 * time(dec, ldec) + N * time(enc_r, lenc)), N2).

