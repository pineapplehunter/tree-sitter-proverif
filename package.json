{
  "name": "tree-sitter-proverif",
  "version": "0.0.1",
  "description": "ProVerif's typed pi calculus grammar for tree-sitter",
  "type": "module",
  "repository": "https://codeberg.org/maribu/tree-sitter-proverif",
  "license": "0BSD",
  "author": {
    "name": "Marian Buschsieweke",
    "email": "marian.buschsieweke@posteo.net",
    "url": "https://mari-bu.de/"
  },
  "main": "bindings/node",
  "types": "bindings/node",
  "keywords": [
    "incremental",
    "parsing",
    "tree-sitter",
    "proverif"
  ],
  "files": [
    "grammar.js",
    "tree-sitter.json",
    "binding.gyp",
    "prebuilds/**",
    "bindings/node/*",
    "queries/*",
    "src/**",
    "*.wasm"
  ],
  "dependencies": {
    "node-addon-api": "^8.5.0",
    "node-gyp-build": "^4.8.4"
  },
  "devDependencies": {
    "prebuildify": "^6.0.1",
    "tree-sitter": "^0.22.4",
    "tree-sitter-cli": "0.27.1"
  },
  "peerDependencies": {
    "tree-sitter": "^0.22.4"
  },
  "peerDependenciesMeta": {
    "tree-sitter": {
      "optional": true
    }
  },
  "scripts": {
    "install": "node-gyp-build",
    "prestart": "tree-sitter build --wasm",
    "start": "tree-sitter playground",
    "generate": "tree-sitter generate",
    "test": "tree-sitter test && node scripts/check-queries.mjs",
    "test:bindings": "node --test bindings/node/*_test.js"
  }
}
